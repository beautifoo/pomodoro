{
	"name": "@beautifoo/claude-pomodoro",
	"version": "0.7.0",
	"description": "Pomodoro plugin for Claude Code: a break when your 25 minutes are up, and a note that lets Claude sum up the session if that helps.",
	"keywords": [
		"claude-code",
		"claude-code-plugin",
		"pomodoro",
		"break-reminder"
	],
	"license": "MIT",
	"author": "Lorenzo Pieri",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beautifoo/pomodoro.git",
		"directory": "packages/claude"
	},
	"files": [
		".claude-plugin/plugin.json",
		"hooks",
		"types"
	],
	"scripts": {
		"build": "cp ../../lib/core/index.ts hooks/core.ts && cp ../../lib/core/messages.ts hooks/messages.ts",
		"prepack": "npm run build"
	}
}
